# =====================================================================
# VoidWave Discord bot configuration
# Copy this file to .env and fill in every value.
# Anything in quotes can be removed if you don't need that feature.
# =====================================================================

# Discord Bot Configuration
# ---------------------------------------------------------------------
# Your bot token from https://discord.com/developers/applications
# (Application -> Bot -> Reset Token). NEVER share this or commit it.
TOKEN=

# Your bot's numeric Application ID (Developers -> General Information).
# Used for slash commands and top.gg/discordbotlist vote tracking.
APPLICATION_ID=

# The main server (guild) ID this bot primarily serves. Used for
# slash-command registration and guild-specific commands.
# Right-click the server icon -> Copy Server ID (enable Developer Mode).
GUILD_ID=

# Your own Discord user ID. Only this user is treated as the owner and
# allowed to use owner-only commands.
# Right-click your username -> Copy User ID (enable Developer Mode).
ALLOWED_USER_ID=

# A long random string used by Flask to sign/encrypt login sessions.
# Generate one with:  python3 -c "import secrets; print(secrets.token_hex(32))"
# MUST be kept secret, otherwise sessions can be forged.
SECRET_KEY=

# Which system prompt profile the bot uses for its LLM replies.
# Picks a file from the prompts/ directory.
PROMPT_NAME=default

# Which Ollama model to use for generating replies (llm.py).
# Example: llama3.2:3b, qwen2.5:7b, etc.
MODEL=llama3.2:3b

# Set to "true" to enable debug/verbose logging in the bot and website.
# Leave empty (or false) in production.
DEBUG=

# Optional: top.gg / discordbotlist API tokens
# ---------------------------------------------------------------------
# Bot-list vote posting + vote webhook verification (top.gg).
# Get from https://top.gg/bot/<id>/webhooks after adding your bot.
TOPGG_TOKEN=

# Same as TOPGG_TOKEN but for discordbotlist.com.
DBL_TOKEN=

# Shared secret (Auth key) you set on your top.gg webhook page.
# Used to verify that incoming vote pings really come from top.gg.
TOPGG_WEBHOOK_AUTH=

# Music (requires Lavalink server)
# ---------------------------------------------------------------------
# Point these at your Lavalink server (run it however you like, e.g.
# as a systemd service or in Docker). IPv6 users may need brackets,
# e.g. http://[::1]:2333
LAVALINK_URI=http://localhost:2333
LAVALINK_PASSWORD=youshallnotpass

# =====================================================================
# Admin panel  (https://voidwave.xangey.dev/admin)
# =====================================================================

# Strong password for the admin login. REQUIRED! without this the
# /admin panel will refuse to start. Choose something long and unique.
ADMIN_PASSWORD=

# Discord webhook URL of a PRIVATE server/channel (only you can see it).
# The admin panel sends the 8-digit 2FA login code here on every login.
# Create one: channel -> Integrations -> Webhooks -> New Webhook.
ADMIN_WEBHOOK_URL=

# Require the webhook 2FA step on top of the password. Keep "true" for
# real security; set to "false" only if you want password-only logins.
ADMIN_REQUIRE_2FA=true
